NODE_ENV=development
# Pooled connection for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/autozap_academy?sslmode=require"
# Direct connection for Prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST/autozap_academy?sslmode=require"
# HMAC secret for signed session cookies (min 32 chars). Required in production.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
DEMO_STUDENT_ID="student-demo-001"
DEMO_ADMIN_ID="admin-demo-001"
